/*
 * brainvar-star-2pass :: nextflow.config
 * Container tags correspond to the EXACT conda builds pinned in the reference
 * repo's envs/: star=2.7.10b=h6b7c446_1, bbmap=39.01=h5c4e2a8_0
 */

manifest {
    name            = 'brainvar-star-2pass'
    description     = 'STAR 2.7.10b two-pass splice-junction pipeline (BrainVar-identical parameters)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}

params {
    fetch_forks   = 4
    cohort        = null
    samplesheet   = null
    genome_url    = null
    gtf_url       = null
    outdir        = null
    keep_contigs  = null
    transcriptome = false
}

process {
    errorStrategy = { task.exitStatus in [104,134,137,138,139,140,143,247,255] ? 'retry' : 'finish' }
    maxRetries    = 3
    cache         = 'lenient'

    // bbmap image carries both wget and gzip; the minimal wget image has no gzip
    withLabel: net {
        container = 'quay.io/biocontainers/bbmap:39.01--h5c4e2a8_0'
        cpus      = 2
        memory    = { 4.GB  * task.attempt }
        time      = { 24.h  * task.attempt }
        errorStrategy = 'retry'
        maxRetries    = 6
    }

    withLabel: small {
        container = 'quay.io/biocontainers/bbmap:39.01--h5c4e2a8_0'
        cpus      = 4
        memory    = { 16.GB * task.attempt }
        time      = { 6.h   * task.attempt }
    }

    withLabel: trim {
        container = 'quay.io/biocontainers/bbmap:39.01--h5c4e2a8_0'
        cpus      = 8
        memory    = { 16.GB * task.attempt }
        time      = { 12.h  * task.attempt }
    }

    withLabel: star {
        container = 'quay.io/biocontainers/star:2.7.10b--h6b7c446_1'
        cpus      = 16
        memory    = { 64.GB * task.attempt }
        time      = { 16.h  * task.attempt }
    }

    // genomeGenerate and pass-2 (on-the-fly sjdb insertion) are the memory peaks
    withLabel: star_big {
        container = 'quay.io/biocontainers/star:2.7.10b--h6b7c446_1'
        cpus      = 16
        memory    = { 120.GB * task.attempt }
        time      = { 24.h   * task.attempt }
    }
}

aws {
    region = 'us-west-2'
    batch {
        maxParallelTransfers  = 8
        maxTransferAttempts   = 5
        delayBetweenAttempts  = '30 sec'
    }
}

timeline { enabled = true }
report   { enabled = true }
trace    { enabled = true }
